# Supabase — get both from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_KEY is the anon key, only used for local dev without RLS
SUPABASE_KEY=

# Supabase Storage bucket for dialer recordings (default: call-recordings). Create bucket in Dashboard or run supabase/scripts/create-call-recordings-bucket.sql
# CALL_RECORDINGS_BUCKET=call-recordings
 
# Auth
JWT_SECRET=
 
# AI services
OPENAI_API_KEY=
SARVAM_API_KEY=
 
# CORS — comma-separated list of allowed frontend origins
# Example: https://your-app.vercel.app
ALLOWED_ORIGINS=
 
# Railway specific — set to 1 in production
TRUST_PROXY=1
 
# TTS chunking (optional — defaults match these; set on Railway too for parity with local)
TTS_FIRST_CHUNK_MIN_CHARS=8
TTS_NEXT_CHUNK_MIN_CHARS=24
TTS_CHUNK_MAX_CHARS=90
# Speak stream tail without .?! if at least this many chars (Telugu streaming)
TTS_FLUSH_SUBSTANTIAL_MIN_CHARS=32
 
# Seed script overrides (optional)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
