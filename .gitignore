# Local environment files (secrets — never commit)
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
backend/.env
backend/.env.local
backend/.env.*.local

# .env.production only contains public build-time URLs — safe to commit
!frontend/.env.production

# Dependencies/build outputs
node_modules/
frontend/node_modules/
backend/node_modules/
dist/
build/
frontend/dist/
frontend/playwright-report/
frontend/test-results/

# Logs and OS artifacts
*.log
.DS_Store
.cursor/

# Runtime JSON database (local dev)
backend/data/
